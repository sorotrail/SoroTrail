# Stellar RPC endpoint (JSON-RPC 2.0). Default is the public testnet node.
# For mainnet, use a provider URL (public mainnet nodes are rate-limited or absent).
RPC_URL=https://soroban-testnet.stellar.org

# Postgres connection string.
DATABASE_URL=postgres://sorotrail:sorotrail@localhost:5432/sorotrail?sslmode=disable

# How often to poll for new events once caught up.
POLL_INTERVAL=5s

# HTTP API listen address.
HTTP_ADDR=:8080

# Optional: comma-separated contract IDs (C...) to watch. Empty = ingest all
# contract events.
WATCHED_CONTRACTS=

# Optional: force ingestion to start from this ledger on cold start.
# If unset, ingestion starts from (latest ledger - RETENTION_LEDGERS).
START_LEDGER=

# How far back to reach on cold start, in ledgers (~5s each; 17280 ≈ 24h).
RETENTION_LEDGERS=17280

# Partition width for the events table, in ledgers (~7 days by default).
PARTITION_LEDGER_SPAN=120960

# debug | info | warn | error
LOG_LEVEL=info

# Ingest-lag alarm threshold, in ledgers. When the gap between the chain
# head (via getLatestLedger) and the last ingested ledger exceeds this
# number, SoroTrail logs a single WARN line; a single INFO line fires
# once the gap closes. Default 100 (~8 minutes at 5s/ledger). Set LAG_WARN_LEDGERS=0
# to disable the alarm entirely (no log lines, no metric updates).
LAG_WARN_LEDGERS=100
# text | json — JSON output is machine-parseable for Loki, CloudWatch, ELK.
LOG_FORMAT=text

# API-originated store reads get a statement timeout and slow-query logging.
# API_QUERY_TIMEOUT=25s
# API_SLOW_QUERY_THRESHOLD=2s

# HTTP server timeouts. Zero disables the timeout for that field.
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_READ_HEADER_TIMEOUT=10s

# Maximum number of filter batches fetched concurrently during a
# windowSweep pass (used when WATCHED_CONTRACTS exceeds the per-request
# cap of 25 contracts). The Stellar RPC's HTTPClient interval limiter
# already serializes public-RPC traffic - only raise this against
# private RPCs that allow more headroom. Default is 1 (sequential,
# preserves existing behavior bit-for-bit for <=25 contracts anyway).
# SWEEP_CONCURRENCY=1

# Number of ledgers behind the ingest frontier that get re-fetched on a
# scheduled basis to detect and correct RPC-side reorgs. Once a ledger
# is more than this many ledgers behind the frontier it is considered
# finalized and never rewritten. Zero disables reorg detection entirely.
# REORG_CONFIRMATION_WINDOW=64

# How often the ingester re-scans the recent finalized window for
# reorgs. Reorg detection shares the live RPC budget and is folded into
# the existing ingestion loop, so this knob only governs cadence.
# REORG_RESCAN_INTERVAL=1m

# Maximum ledger span a single /contracts/{id}/export call may request.
# The handler streams the export with chunked transfer encoding so it
# never loads the full result set into memory, but unbounded spans
# risk long-running queries against the database. The default of
# 17280 ~ 24h matches the contract event retention window without
# granting an unbounded analytical dump.
# EXPORT_MAX_RANGE=17280

# HTTP rate limiting (per client IP). Both must be set together to enable;
# when unset the middleware is a no-op (preserving existing behavior).
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20

# How long to wait for an in-flight request to finish during graceful
# shutdown. Zero means wait indefinitely. Default is 15s.
# SHUTDOWN_TIMEOUT=15s

# Honour X-Forwarded-For for client IP detection. Only enable behind a
# trusted proxy that strips/rewrites the header — clients control XFF
# themselves, so enabling it on an Internet-facing surface lets any
# caller pick their own rate-limit key.
# RATE_LIMIT_TRUSTED_PROXY=false

# --- Multi-tenancy -----------------------------------------------------
# Serve several consumers from one deployment: API keys scoped to specific
# contracts, per-tenant watch lists, quotas and usage accounting.
#
# Off by default. With MULTI_TENANT unset the API requires no credential and
# applies no tenant boundary — exactly the pre-multi-tenancy behavior.
# Turning it on makes a key mandatory on every endpoint except /health, so
# plan the cutover for existing clients.
#
# See docs/multi-tenancy.md.
# MULTI_TENANT=false

# Cap on the union of every tenant's watch list (not on any single list):
# what costs RPC budget is the number of distinct contracts polled. 0 = no cap.
# MULTI_TENANT_MAX_WATCHED=250

# How often per-tenant usage counters are flushed from memory to Postgres.
# MULTI_TENANT_USAGE_FLUSH=10s

# How often an open stream re-resolves its tenant's grants. This bounds how
# long a revoked contract keeps being delivered to an already-connected
# client, and how long a newly granted one takes to start flowing.
# MULTI_TENANT_STREAM_SCOPE_SYNC=30s

# First-boot admin credential for a fresh multi-tenant install: minting a key
# requires an admin key, so without this there is no way in. Installed for the
# seeded "default" tenant at startup; revoke it once real keys exist.
# Format: st_<16 base32 chars>_<secret>
# MULTI_TENANT_BOOTSTRAP_KEY=
# Horizon REST endpoint used by `sorotrail backfill` only — live
# ingestion does not touch Horizon.
HORIZON_URL=https://horizon-testnet.stellar.org

# Pace the backfill against Horizon. 10 req/s matches the public
# Horizon cap; private deployments may safely go higher.
# BACKFILL_RATE_RPS=10
