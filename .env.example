[TEMPLATE]
# Every variable the code reads is documented here. The list is generated
# from internal/config/config.go struct tags to prevent drift.

# --- Ingester backoff --------------------------------------------------
# Initial and maximum error backoff for the ingester's retry loop.
# INGESTER_MIN_BACKOFF=1s
# INGESTER_MAX_BACKOFF=1m

# Bounds for additive retry jitter. Zero preserves proportional jitter.
# INGESTER_JITTER_MIN=0
# INGESTER_JITTER_MAX=0

# --- Network and RPC ---------------------------------------------------
# Stellar network to index. Must be one of testnet, mainnet, futurenet.
NETWORK=testnet

# Stellar RPC endpoint (JSON-RPC 2.0). Default matches NETWORK.
# Ignored when RPC_URLS is set.
RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated, priority-ordered list of RPC endpoints for the
# multi-provider failover client. When set, RPC_URL is ignored.
# RPC_URLS=

# Per-provider request rate limit (requests/second). Only used with RPC_URLS.
# RPC_RATE_LIMIT_RPS=10

# Single-provider request rate limit (requests/second). Default matches the
# public endpoint limit. Ignored when RPC_URLS is set.
# RPC_RATE_LIMIT=10

# Maximum retry attempts per failing RPC call.
# RPC_MAX_ATTEMPTS=3

# Initial retry backoff duration; doubles each retry.
# RPC_BASE_BACKOFF=500ms

# Upper bound on the retry backoff.
# RPC_MAX_BACKOFF=30s

# Randomize backoff to [0.5x, 1.5x) to prevent thundering-herd.
# RPC_JITTER=true
# Timeout on RPC HTTP requests (e.g. 30s). Raise for slow private RPCs.
# RPC_HTTP_TIMEOUT=30s

# --- Database ----------------------------------------------------------
# Connection string. Use postgres:// for production, or sqlite:./sorotrail.db
# for a zero-dependency single-binary setup.
#DATABASE_URL=sqlite:./sorotrail.db
DATABASE_URL=postgres://sorotrail:sorotrail@localhost:5432/sorotrail?sslmode=disable
# Max DB connections in the pool (0 = pgx default).
# DB_MAX_CONNS=20
# Min DB connections kept warm in the pool (0 = pgx default).
# DB_MIN_CONNS=0
# Max lifetime of a DB connection (0 = no limit). e.g. 30m.
# DB_MAX_CONN_LIFETIME=0
# Max idle time of a DB connection (0 = no limit). e.g. 5m.
# DB_MAX_CONN_IDLE_TIME=0

# How often to poll for new events once caught up. Changeable without a
# restart: sending SIGHUP to the running process re-reads this (and
# LOG_LEVEL) from the environment and applies it live if valid.
# --- Ingestion ---------------------------------------------------------
# How often to poll for new events once caught up.
POLL_INTERVAL=5s

# Optional: bound an adaptive poll interval instead of a fixed one. Once
# caught up, the effective interval shrinks toward POLL_INTERVAL_MIN when a
# cycle just observed backlog and grows toward POLL_INTERVAL_MAX on an idle
# cycle — see /stats' ingester.effective_poll_interval_ms for the live
# value. Both unset (the default) disables adaptation: the ingester always
# polls at exactly POLL_INTERVAL, identical to pre-adaptive behavior.
POLL_INTERVAL_MIN=
POLL_INTERVAL_MAX=

# HTTP API listen address.
HTTP_ADDR=:8080

# Maximum HTTP request body size in bytes.
# HTTP_REQUEST_BODY_LIMIT=1048576

# Comma-separated contract IDs (C...) to watch. Empty = ingest all.
WATCHED_CONTRACTS=

# Force cold-start ingestion from this ledger. Accepts absolute number or
# relative offset like latest-1000.
START_LEDGER=

# Raw form of START_LEDGER before parsing. Used internally.
# START_LEDGER_RAW=

# Cold-start reach-back in ledgers (~24h at 5s/ledger).
RETENTION_LEDGERS=17280

# Delete events older than this duration. 0 disables age-based pruning.
# RETENTION_AGE=0

# How often the age-based pruner re-examines events older than RETENTION_AGE.
# RETENTION_POLL_INTERVAL=1h

# Maximum events per getEvents RPC page.
# INGEST_PAGE_SIZE=1000

# Number of events per upsert batch during ingestion.
# INGEST_BATCH_SIZE=1000

# Ledger range per events-table partition (~7 days at 5s/ledger).
PARTITION_LEDGER_SPAN=120960

# debug | info | warn | error. Also hot-reloadable via SIGHUP, see
# POLL_INTERVAL above.
# Concurrent filter batches during windowSweep. Only helps with private RPCs.
# SWEEP_CONCURRENCY=1

# Cap on events per ingestion cycle. 0 disables.
# MAX_EVENTS_PER_CYCLE=0

# Maximum events per store write. 0 keeps single-write-per-page.
# BATCH_SIZE=0

# Adaptive batch latency budget. Only effective with BATCH_SIZE.
# BATCH_TARGET_LATENCY=0

# Maximum backpressure sleep between batch writes.
# BATCH_MAX_BACKOFF=1s

# Initial error backoff for the ingester.
# INGESTER_MIN_BACKOFF=1s

# Maximum error backoff for the ingester.
# INGESTER_MAX_BACKOFF=1m

# Minimum additive jitter for ingester errors.
# INGESTER_JITTER_MIN=0

# Exclusive maximum additive jitter. Zero preserves proportional jitter.
# INGESTER_JITTER_MAX=0

# Advisory lock to prevent double-ingestion.
# INGESTION_LOCK_ENABLED=false

# --- Reorg detection ---------------------------------------------------
# Ledgers behind frontier re-scanned for reorgs. 0 disables.
# REORG_CONFIRMATION_WINDOW=64

# Cadence of the reorg re-scan.
# REORG_RESCAN_INTERVAL=1m

# --- Logging -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# text | json
LOG_FORMAT=text

# Ingest-lag alarm threshold in ledgers. 0 disables.
LAG_WARN_LEDGERS=100

# --- API server --------------------------------------------------------
# HTTP server timeouts. Zero disables.
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_READ_HEADER_TIMEOUT=10s
# Maximum accepted request body size in bytes.
# HTTP_REQUEST_BODY_LIMIT=1048576

# Per-request database timeout for API reads.
# API_QUERY_TIMEOUT=25s

# Warn threshold for slow API queries.
# API_SLOW_QUERY_THRESHOLD=2s

# Upper bound on the limit and recent page-size parameters for list
# endpoints. Requests above the cap are rejected with 400, not clamped.
# API_MAX_LIMIT=500

# API key for /watched-contracts management. Empty rejects all writes.
# API_KEY=

# How long /stats is cached. 0 disables.
# STATS_CACHE_TTL=5s

# Flip Cache-Control from public to private.
# CACHE_PRIVATE=false

# Response body size (bytes) for gzip/deflate. Negative disables.
# COMPRESS_MIN_SIZE=0

# Expose Prometheus /metrics endpoint.
# ENABLE_METRICS=false

# Graceful shutdown timeout. 0 waits indefinitely.
# SHUTDOWN_TIMEOUT=15s

# --- CORS --------------------------------------------------------------
# Allowed browser origins. Empty = disabled. * = any origin.
# CORS_ALLOWED_ORIGINS=

# Methods returned on preflight.
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Headers returned on preflight.
# CORS_ALLOWED_HEADERS=Content-Type,X-API-Key,Accept

# Headers exposed to browser JS.
# CORS_EXPOSED_HEADERS=X-Request-ID,X-RateLimit-Remaining

# --- Rate limiting -----------------------------------------------------
# Per-client HTTP rate limit. Both must be set together.
# RATE_LIMIT_RPS=0
# RATE_LIMIT_BURST=0

# Honor X-Forwarded-For for client IP. Only behind trusted proxy.
# RATE_LIMIT_TRUSTED_PROXY=false

# Optional API key authentication. When true, write, streaming, and
# subscription-management endpoints require a valid API key presented as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`. Read endpoints
# (/events, /stats, /health) stay public. Keys are issued/revoked via
# `sorotrail apikey` or the /apikeys endpoints. Defaults to false.
# API_KEY_AUTH_ENABLED=false
# Per-client hourly request quota. 0 disables the quota window.
# HOURLY_QUOTA=0

# Per-client daily request quota. 0 disables the quota window.
# DAILY_QUOTA=0

# --- Audit -------------------------------------------------------------
# Enable background auditor. false = pre-audit behavior.
# AUDIT_ENABLED=false

# Sleep between audit passes.
# AUDIT_POLL_INTERVAL=30s

# Ledger range per audit pass.
# AUDIT_BATCH_LEDGERS=100

# Auditor lag threshold behind ingest frontier.
# AUDIT_LAG_THRESHOLD=200

# Audit share of the request budget [0,1].
# AUDIT_BUDGET_SHARE=0.10

# Total request budget (requests/second).
# AUDIT_MAX_RPS=10

# Repair attempts before finding is unrecoverable.
# AUDIT_MAX_REPAIR_ATTEMPTS=3

# Maximum ledger span per audit finding.
# AUDIT_FINDING_MAX_LEDGERS=100

# --- Retention pruning -------------------------------------------------
# Delete events older than this duration. 0 disables.
# RETENTION_MAX_AGE=0

# Delete events with ledger below this. 0 disables.
# RETENTION_MIN_LEDGER=0

# Events deleted per pruner transaction.
# RETENTION_BATCH_SIZE=5000

# Sleep between pruner batches.
# RETENTION_PAUSE=100ms

# How often the pruner runs.
# RETENTION_INTERVAL=1h

# Report what would be deleted without removing rows.
# RETENTION_DRY_RUN=false

# --- Archive (optional) ------------------------------------------------
# Export pruned events to S3-compatible storage as compressed NDJSON.
# ARCHIVE_BUCKET is the master switch; ARCHIVE_ENDPOINT is required when set.
#
# ARCHIVE_BUCKET=
# ARCHIVE_PREFIX=
# ARCHIVE_ENDPOINT=
# ARCHIVE_REGION=
# ARCHIVE_ACCESS_KEY_ID=
# ARCHIVE_SECRET_ACCESS_KEY=
# ARCHIVE_USE_SSL=false
# ARCHIVE_BEFORE_PRUNE=false
# ARCHIVE_MAX_RETRIES=3

# --- Export ------------------------------------------------------------
# Max ledger span for /contracts/{id}/export.
# EXPORT_MAX_RANGE=17280

# --- Multi-tenancy -----------------------------------------------------
# Enable multi-tenant mode. false = no auth, no tenant boundary.
# MULTI_TENANT=false

# Cap on union of all tenants watch lists. 0 = no cap.
# MULTI_TENANT_MAX_WATCHED=250

# How often per-tenant usage counters are flushed.
# MULTI_TENANT_USAGE_FLUSH=10s

# Stream grant re-resolution interval.
# MULTI_TENANT_STREAM_SCOPE_SYNC=30s

# Bootstrap admin key for fresh install. Rotate after setup.
# MULTI_TENANT_BOOTSTRAP_KEY=

# --- Horizon backfill --------------------------------------------------
# Horizon REST endpoint (backfill command only).
HORIZON_URL=https://horizon-testnet.stellar.org

# Backfill request pace (requests/second).
# BACKFILL_RATE_RPS=10

# --- GraphQL -----------------------------------------------------------
# Enable GraphiQL UI at /graphiql.
# GRAPHQL_PLAYGROUND=false

# --- Metrics -----------------------------------------------------------
# Enable metrics collection.
# METRICS_ENABLED=false
