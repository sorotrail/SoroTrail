      "title": "RPC Call Latency (P50 / P95 / P99)",
      "description": "Wall-clock duration of JSON-RPC calls (HTTP round trip + body read + parse). The dashed red line at 5 s marks the P99 alerting threshold — above this the ingester can't keep up with a 5 s poll interval.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, rate(sorotrail_rpc_call_duration_seconds_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, rate(sorotrail_rpc_call_duration_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, rate(sorotrail_rpc_call_duration_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
