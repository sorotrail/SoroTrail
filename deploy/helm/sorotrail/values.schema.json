{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["database"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pod replicas."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Container image repository."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy."
        },
        "tag": {
          "type": "string",
          "description": "Image tag override. Defaults to the chart's appVersion."
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Secrets for pulling images from private registries."
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full release name."
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a dedicated ServiceAccount for the pod."
        },
        "annotations": {
          "type": "object",
          "description": "Annotations for the ServiceAccount."
        },
        "name": {
          "type": "string",
          "description": "Use an existing ServiceAccount instead of creating one."
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "description": "Annotations applied to the pod."
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Pod-level security context."
    },
    "securityContext": {
      "type": "object",
      "description": "Container-level security context."
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "description": "Kubernetes Service type."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port."
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port to forward to."
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "description": "CPU/memory requests and limits.",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector for pod scheduling."
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for pod scheduling."
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod scheduling."
    },
    "config": {
      "type": "object",
      "properties": {
        "rpcUrl": {
          "type": "string",
          "format": "uri",
          "description": "Stellar RPC endpoint (JSON-RPC 2.0)."
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$",
          "description": "How often to poll for new events once caught up (Go duration)."
        },
        "httpAddr": {
          "type": "string",
          "description": "HTTP API listen address. Must match the container port (8080)."
        },
        "watchedContracts": {
          "type": "string",
          "description": "Comma-separated contract IDs to watch. Empty = ingest all."
        },
        "startLedger": {
          "type": "string",
          "description": "Force ingestion to start from this ledger sequence number."
        },
        "retentionLedgers": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "How far back to reach on cold start, in ledgers (~5 s each)."
        },
        "partitionLedgerSpan": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Partition width for the events table, in ledgers."
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "description": "Log verbosity."
        },
        "corsAllowedOrigins": {
          "type": "string",
          "description": "Comma-separated browser origins for CORS. Empty = disabled."
        },
        "rateLimitRps": {
          "type": "string",
          "description": "Per-client-IP rate limit requests/second. Must be set with rateLimitBurst."
        },
        "rateLimitBurst": {
          "type": "string",
          "description": "Per-client-IP rate limit burst size. Must be set with rateLimitRps."
        },
        "rateLimitTrustedProxy": {
          "anyOf": [
            { "type": "string", "enum": ["", "true", "false"] },
            { "type": "boolean" }
          ],
          "description": "Honor X-Forwarded-For for client IP detection."
        },
        "enableMetrics": {
          "anyOf": [
            { "type": "string", "enum": ["", "true", "false"] },
            { "type": "boolean" }
          ],
          "description": "Expose the Prometheus /metrics endpoint."
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret containing the DATABASE_URL."
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1,
          "description": "Key within the existing secret that holds the DATABASE_URL value."
        },
        "url": {
          "type": "string",
          "description": "Inline Postgres connection string. Ignored when existingSecret is set."
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a PodDisruptionBudget."
        },
        "minAvailable": {
          "type": ["integer", "string"],
          "description": "Minimum number of pods that must remain available."
        },
        "maxUnavailable": {
          "type": ["integer", "string"],
          "description": "Maximum number of pods that may be unavailable."
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a Prometheus ServiceMonitor resource."
        },
        "namespace": {
          "type": "string",
          "description": "Namespace for the ServiceMonitor. Defaults to the release namespace."
        },
        "additionalLabels": {
          "type": "object",
          "description": "Extra labels for the ServiceMonitor."
        },
        "interval": {
          "type": "string",
          "description": "Scrape interval."
        },
        "scrapeTimeout": {
          "type": "string",
          "description": "Scrape timeout."
        },
        "path": {
          "type": "string",
          "description": "Metrics endpoint path."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
